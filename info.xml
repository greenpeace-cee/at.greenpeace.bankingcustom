<?xml version="1.0"?>
<extension key="at.greenpeace.bankingcustom" type="module">
  <file>bankingcustom</file>
  <name>Greenpeace Banking Customizations</name>
  <description>Various Greenpeace-specific customizations for CiviBanking</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Patrick Figel</author>
    <email>pfigel@greenpeace.org</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/greenpeace-cee/at.greenpeace.bankingcustom</url>
    <url desc="Documentation">https://github.com/greenpeace-cee/at.greenpeace.bankingcustom</url>
    <url desc="Support">https://github.com/greenpeace-cee/at.greenpeace.bankingcustom/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2024-09-11</releaseDate>
  <version>0.2.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.69</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/Bankingcustom</namespace>
    <format>23.02.1</format>
  </civix>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>smarty-v2@1.0.1</mixin>
  </mixins>
</extension>
